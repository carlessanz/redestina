# Dependencias y build
node_modules/
dist/

# Variables de entorno locales (contienen claves)
.env.local
.env.*.local
# La guía técnica usa este fichero para subir los secretos a Supabase de una vez.
# OJO: la regla .env* de más abajo NO lo cubre, porque empieza por ".secrets".
.secrets.env

# Supabase CLI
supabase/.temp/
supabase/.branches/
# Lockfiles por función: se generan al desplegar/checkear; no se versionan
supabase/functions/*/deno.lock

# Documentación de trabajo local (notas, prompts, specs): nunca entra en git
/docs/

# Datos maestros del Excel ARA: llevan teléfonos, emails y NIF de personas reales
/scripts/data/

# Configuración local de Claude Code (rutas y puertos de esta máquina; hoy solo
# la cubría el ignore global del usuario, que no viaja con el repo)
.claude/settings.local.json
.claude/launch.json

# Sistema / editor
.DS_Store
*.log
.vercel
.env*
# ...salvo la plantilla de variables, que sí se versiona
!.env.local.example

# Cobertura de Vitest
coverage/
